{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orotitan:pilotage:d6:i2-full-precision-provenance:proposed-v0.1.0",
  "title": "OroTitan I2 full-precision provenance envelope — PROPOSAL ONLY",
  "description": "Proposed D6 machine-readable envelope; NOT a frozen methodology authority and NOT an I2_PASS attestation. All references are checked against D2 byte-verified artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "data_cutoff",
    "stage_revision",
    "contract_set_sha256",
    "artifact_identity",
    "research_evidence_ref",
    "canonical_contract_input",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "D6_PROPOSED_0.1.0"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date"
    },
    "stage_revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "research_evidence_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "canonical_contract_input": {
      "type": "object",
      "minProperties": 8
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_pointer",
          "source_ref",
          "source_pointer",
          "authority_role"
        ],
        "properties": {
          "input_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "source_ref": {
            "$ref": "#/$defs/artifactRef"
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "authority_role": {
            "enum": [
              "FUNDAMENTAL_JUDGMENT",
              "CERTIFICATION_JUDGMENT",
              "VALUATION_JUDGMENT",
              "TERMINAL_GATE_JUDGMENT"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "content_sha256",
        "artifact_type",
        "stage_code"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "stage_code": {
          "enum": [
            "RESEARCH",
            "DEEP_DIVE"
          ]
        }
      }
    }
  }
}
