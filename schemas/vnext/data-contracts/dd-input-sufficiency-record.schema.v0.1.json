{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orotitan.local/schemas/vnext/data-contracts/dd-input-sufficiency-record.v0.1.json",
  "title": "OroTitan DD Input Sufficiency Record V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "record_version",
    "scope_type",
    "blocks",
    "critical_blockers",
    "ready_for_deep_dive"
  ],
  "properties": {
    "context": {
      "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/payloadContext"
    },
    "record_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_type": {
      "enum": [
        "INITIAL",
        "FULL_REFRESH_REQUIRED",
        "TARGETED_REFRESH"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "applicability",
          "dd_input_status",
          "mandatory_coverage",
          "evidence_adequacy",
          "material_blocking_gaps",
          "key_evidence_ids",
          "key_conflict_ids",
          "searches_performed",
          "best_next_source",
          "rationale"
        ],
        "properties": {
          "block_id": {
            "enum": [
              "IDENTITY_PIT_INPUTS",
              "BUSINESS_MODEL_INPUTS",
              "MOAT_INPUTS",
              "RUNWAY_INPUTS",
              "RETURN_QUALITY_INPUTS",
              "FCF_FORENSIC_INPUTS",
              "CAPITAL_ALLOCATION_INPUTS",
              "MANAGEMENT_GOVERNANCE_INPUTS",
              "OUTSIDE_VIEW_INPUTS",
              "RISK_RESILIENCE_INPUTS",
              "VALUATION_INPUTS"
            ]
          },
          "applicability": {
            "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/procedureApplicability"
          },
          "dd_input_status": {
            "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/ddInputStatus"
          },
          "mandatory_coverage": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidence_adequacy": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "material_blocking_gaps": {
            "type": "array",
            "items": {
              "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "key_evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "key_conflict_ids": {
            "type": "array",
            "items": {
              "$ref": "./orotitan-analytical-common.v0.1.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "searches_performed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "best_next_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "critical_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ready_for_deep_dive": {
      "enum": [
        "YES",
        "NO"
      ]
    }
  }
}
