NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=replace-with-a-strong-personal-password
# Recommended dedicated signing secret. If omitted at runtime, V1.1 derives a server-only HMAC key from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
TWELVE_DATA_API_KEY=your-twelve-data-api-key
CRON_SECRET=replace-with-a-long-random-secret

# Optional, server-only: Supabase Management API project-scoped read-only token
# Required ONLY for deep D2-D8 verification inside /admin/orotitan; listing needs no token.
# Grant Project Settings / Read for project cugpgtzygqqlxetyeven. Never use NEXT_PUBLIC_.
SUPABASE_MANAGEMENT_READ_TOKEN=

# Product Research inbox pilot: LOCAL Next.js development only, no cloud writes.
# NODE_ENV=production always disables the pilot even if this flag is "1".
# Request receipts are stored in .orotitan-local/ on the SAME server machine.
OROTITAN_LOCAL_REQUESTS_ENABLED=0

# DRAFT shared pilot: disabled by default, only possible in NODE_ENV=development.
# Use an independently configured NON-PRODUCTION Supabase test project;
# NEVER the real OroTitan Free project or production service key.
OROTITAN_SHARED_INBOX_TEST_ENABLED=0
OROTITAN_SHARED_INBOX_TEST_PROJECT_REF=
OROTITAN_SHARED_INBOX_TEST_URL=
OROTITAN_SHARED_INBOX_TEST_SERVICE_KEY=

# C8 SOLO_OWNER candidate (SHADOW only). All switches remain disabled until
# separate amendment ratification, Preview qualification and acceptance GO.
OROTITAN_C8_OWNER_AUTH_ENABLED=0
OROTITAN_C8_OWNER_AUTH_URL=https://awgsurdyvsyolcgpnygh.supabase.co
# Publishable/legacy anon key only. Never put service_role or sb_secret_ here.
OROTITAN_C8_OWNER_AUTH_PUBLISHABLE_KEY=
OROTITAN_C8_SOLO_OWNER_USER_ID=
OROTITAN_C8_SOLO_AMENDMENT_RATIFIED=0
OROTITAN_C8_SOLO_AMENDMENT_REF=
OROTITAN_C8_SOLO_AMENDMENT_SHA256=
