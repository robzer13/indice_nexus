NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=replace-with-a-strong-personal-password
# Recommended dedicated signing secret. If omitted at runtime, V1.1 derives a server-only HMAC key from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
TWELVE_DATA_API_KEY=your-twelve-data-api-key
CRON_SECRET=replace-with-a-long-random-secret

# Server-only read credential for the private OroTitan artifact archive.
# Use a fine-grained GitHub token restricted to Contents: Read on the archive repository.
OROTITAN_PRIVATE_GITHUB_TOKEN=replace-with-read-only-token
OROTITAN_PRIVATE_GITHUB_REPOSITORIES=robzer13/real-orotitan
