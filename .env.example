NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=replace-with-a-strong-personal-password
# Recommended dedicated signing secret. If omitted at runtime, V1.1 derives a server-only HMAC key from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
TWELVE_DATA_API_KEY=your-twelve-data-api-key
CRON_SECRET=replace-with-a-long-random-secret

# Optional, server-only: Supabase Management API project-scoped read-only token
# Required ONLY for deep D2-D8 verification inside /admin/orotitan; listing needs no token.
# Grant Project Settings / Read for project cugpgtzygqqlxetyeven. Never use NEXT_PUBLIC_.
SUPABASE_MANAGEMENT_READ_TOKEN=

# Manual ChatGPT work-products: OFF by default until explicit production approval.
# Server-only. Quarantines text, JSON, CSV and Markdown under the existing private bucket.
# Never registers artifacts, completes stages, publishes or invokes an AI model.
OROTITAN_MANUAL_INTAKE_ENABLED=false

# Remote MCP Bridge prototype for ChatGPT — DISABLED unless explicitly approved.
# Keep every value server-side; do not expose a token or service role in browser code.
# A fixed bearer token is for closed integration testing; production ChatGPT plugin
# availability and OAuth/connection requirements must be validated separately.
OROTITAN_MCP_ENABLED=false
OROTITAN_MCP_PUBLIC_ORIGIN=
OROTITAN_MCP_READ_TOKEN=
OROTITAN_MCP_ALLOWED_RUN_IDS=
OROTITAN_MCP_WRITE_ENABLED=false
