{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/auth/**/*.ts",
    "lib/data/**/*.ts",
    "lib/domain/**/*.ts",
    "lib/market/**/*.ts",
    "lib/orotitan-equity/**/*.ts",
    "lib/supabase/**/*.ts",
    "tests/*.test.ts",
    "scripts/vnext-gate18-phase-b.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
