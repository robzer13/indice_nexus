{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orotitan:equity-research:evidence-ledger:v2.0-draft",
  "title": "OroTitan Evidence Ledger V2 — Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "run_lock",
    "generated_at",
    "method_version",
    "artifact_role",
    "sources",
    "evidence_items"
  ],
  "properties": {
    "contract_name": {
      "const": "OROTITAN_EVIDENCE_LEDGER_V2"
    },
    "schema_version": {
      "const": "2.0.0-draft"
    },
    "run_lock": {
      "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/runContextLock"
    },
    "generated_at": {
      "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/timestamp"
    },
    "method_version": {
      "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
    },
    "artifact_role": {
      "const": "EVIDENCE_LEDGER"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "source_class",
        "source_date",
        "data_period",
        "url_or_locator",
        "root_source_id",
        "retrieved_at",
        "access_status",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/id"
        },
        "title": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
        },
        "publisher": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
        },
        "source_class": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/sourceClass"
        },
        "source_date": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/dateOrState"
        },
        "data_period": {
          "anyOf": [
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
            },
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/specialState"
            }
          ]
        },
        "url_or_locator": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
        },
        "root_source_id": {
          "anyOf": [
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/id"
            },
            {
              "type": "string",
              "enum": [
                "NOT_APPLICABLE",
                "UNKNOWN"
              ]
            }
          ]
        },
        "retrieved_at": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/timestamp"
        },
        "access_status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "INACCESSIBLE"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
          }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "claim_summary",
        "epistemic_type",
        "evidence_role",
        "polarity",
        "materiality",
        "affected_blocks",
        "source_locator",
        "source_date",
        "data_period",
        "admission_status",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/id"
        },
        "source_id": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/id"
        },
        "claim_summary": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
        },
        "epistemic_type": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/epistemicType"
        },
        "evidence_role": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/evidenceRole"
        },
        "polarity": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/polarity"
        },
        "materiality": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/materiality"
        },
        "affected_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/block"
          }
        },
        "source_locator": {
          "anyOf": [
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
            },
            {
              "type": "string",
              "enum": [
                "NOT_APPLICABLE",
                "UNKNOWN"
              ]
            }
          ]
        },
        "source_date": {
          "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/dateOrState"
        },
        "data_period": {
          "anyOf": [
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
            },
            {
              "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/specialState"
            }
          ]
        },
        "admission_status": {
          "type": "string",
          "enum": [
            "ADMITTED",
            "PENDING",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "urn:orotitan:equity-research:analytical-common:v2.0-draft#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
