      "const": "PRE_CERTIFICATION_CHALLENGE_REPORT"
    },
    "schema_version": {
      "const": "1.1"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date"
    },
    "challenge_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.1"
    },
    "challenge_iteration": {
      "type": "integer",
      "minimum": 1
    },
    "question_ledger_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "total_candidate_questions_generated": {
      "type": "integer",
      "minimum": 0
    },
    "total_questions_executed": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_already_resolved_count": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_non_material_count": {
      "type": "integer",
      "minimum": 0
    },
    "pass_count": {
      "type": "integer",
      "minimum": 0
    },
    "concern_count": {
      "type": "integer",
      "minimum": 0
    },
    "reopen_count": {
      "type": "integer",
      "minimum": 0
    },
    "fail_count": {
      "type": "integer",
      "minimum": 0
    },
    "material_concerns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blind_spots_identified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "company_specific_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reopen_required": {
