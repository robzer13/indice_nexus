        "PASS",
        "PASS_WITH_CONCERNS",
        "REOPEN",
        "FAIL"
      ]
    },
    "ready_for_certification": {
      "enum": [
        "YES",
        "NO"
      ]
    },
    "fundamentals_lock_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "valuation_lock_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mode": {
      "enum": [
        "FULL",
        "DELTA"
      ]
    },
    "delta_provenance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prior_passing_report_ref",
            "prior_passing_ledger_ref",
            "impact_map",
            "inherited_coverage_revalidated"
          ],
          "properties": {
            "prior_passing_report_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "version",
                "content_sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "prior_passing_ledger_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "version",
                "content_sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "impact_map": {
              "type": "string",
              "minLength": 1
            },
            "inherited_coverage_revalidated": {
              "const": true
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "challenge_status": {
            "enum": [
              "REOPEN",
              "FAIL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ready_for_certification": {
            "const": "NO"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "challenge_status": {
            "enum": [
              "PASS",
              "PASS_WITH_CONCERNS"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ready_for_certification": {
            "const": "YES"
          }
        }
      }
    }
  ]
}
