  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "company",
    "run_id",
    "data_cutoff",
    "challenge_version",
    "challenge_iteration",
    "question_ledger_ref",
    "total_candidate_questions_generated",
    "total_questions_executed",
    "dropped_duplicate_count",
    "dropped_already_resolved_count",
    "dropped_non_material_count",
    "pass_count",
    "concern_count",
    "reopen_count",
    "fail_count",
    "material_concerns",
    "blind_spots_identified",
    "company_specific_questions",
    "reopen_required",
    "fail_reasons",
    "affected_analytical_blocks",
    "saturation_record",
    "challenge_status",
    "ready_for_certification",
    "fundamentals_lock_ref",
    "valuation_lock_ref",
    "mode",
    "delta_provenance"
