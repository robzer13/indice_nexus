OROTITAN_ENVIRONMENT=VNEXT_SHADOW
OROTITAN_EXPECTED_SUPABASE_PROJECT_REF=awgsurdyvsyolcgpnygh
NEXT_PUBLIC_SUPABASE_URL=https://awgsurdyvsyolcgpnygh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-shadow-service-role-key
OROTITAN_PUBLICATION_ENABLED=false

# Gate 13 Azure analytical model provider.
# Keep AZURE_OPENAI_API_KEY secret. Never commit a real key.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key

# Pin the public retail-price snapshot used to estimate billable cost.
# Populate these from the exact Azure model/deployment pricing in force
# for the live smoke test. Values are USD per 1M tokens.
AZURE_OPENAI_PRICING_SOURCE=https://azure.microsoft.com/pricing/details/ai-foundry-models/aoai/
AZURE_OPENAI_PRICING_EFFECTIVE_DATE=YYYY-MM-DD
AZURE_OPENAI_INPUT_USD_PER_1M=0
AZURE_OPENAI_CACHED_INPUT_USD_PER_1M=0
AZURE_OPENAI_OUTPUT_USD_PER_1M=0
